// test_core_asic.mem  -  RV32I_core_asic test program for AHB_imem_subordinate
// One 32-bit word per line, line N = word address N (byte address 4*N).
// Unused words are filled with NOP (addi x0, x0, 0 = 00000013).
// 2048 words = 0x2000 bytes (ADDR_SIZE_I in AHB_pkg.sv).

// ---- PHASE A – Arithmetic & Logical Immediate / Register (imem 0-9)
ff0100b7  // 0x0000: lui  x1, 0xFF010   ; x1 = 0xFF010000
f0008093  // 0x0004: addi x1, x1, -256  ; x1 = 0xFF00FF00
0f0f1137  // 0x0008: lui  x2, 0x0F0F1   ; x2 = 0x0F0F1000
f0f10113  // 0x000c: addi x2, x2, -241  ; x2 = 0x0F0F0F0F
0020f1b3  // 0x0010: and  x3, x1, x2    ; x3 = 0x0F000F00
0020e233  // 0x0014: or   x4, x1, x2    ; x4 = 0xFF0FFF0F
0020c2b3  // 0x0018: xor  x5, x1, x2    ; x5 = 0xF00FF00F
fff0c313  // 0x001c: xori x6, x1, -1    ; x6 = ~x1 = 0x00FF00FF
0040d493  // 0x0020: srli x9, x1, 4     ; x9 = 0x0FF00FF0
00911533  // 0x0024: sll  x10, x2, x9   ; shift amt = x9[4:0]=16 -> x10=0x0F0F0000
// ---- PHASE B  –  SLT / SLTU / SLTI / SLTIU  (imem 10-16)
fff00593  // 0x0028: addi x11, x0, -1   ; x11 = 0xFFFFFFFF
00100613  // 0x002c: addi x12, x0, 1    ; x12 = 1
00c5a6b3  // 0x0030: slt  x13, x11, x12 ; x13 = 1
00c5b733  // 0x0034: sltu x14, x11, x12 ; x14 = 0
0005a793  // 0x0038: slti x15, x11, 0   ; x15 = 1
0015b813  // 0x003c: sltiu x16, x11, 1  ; x16 = 0
00b628b3  // 0x0040: slt  x17, x12, x11 ; x17 = 0
00000013
00000013
